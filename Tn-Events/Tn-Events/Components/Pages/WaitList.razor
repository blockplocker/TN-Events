@page "/waitlist"
@using Services.Dto.Response
@using Services.Services.Interfaces
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

<PageTitle>VänteLista</PageTitle>

<h3>Alla event du är köad till</h3>

@if (waitlist == null)
{
    <p>Laddar...</p>
}
else if (!waitlist.Any())
{
    <p>Du är inte köad till något event just nu.</p>
}
else
{
    <div class="row">
        @foreach (var ev in waitlist)
        {
            <div class="col-md-4 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            @ev.Title
                        </h5>
                        <p class="card-text">@ev.CategoryName</p>
                        <p class="card-text"><small>@ev.StartDate.ToString("yyyy-MM-dd HH:mm")</small></p>
                        @if (!ev.IsCancelled)
                        {
                            <p class="card-text">Platser kvar: @ev.AvailableSpots / @ev.Capacity</p>
                        }
                        <a href="/events/@ev.Id" class="btn btn-primary">Visa</a>
                    </div>
                </div>
        }
    </div>
}

@code {
    private List<EventResponseDto>? waitlist;

    protected override async Task OnInitializedAsync()
    {
        waitlist = await BookingService.GetWaitlistEventsAsync();
    }

}
