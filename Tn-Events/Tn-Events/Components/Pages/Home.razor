@page "/"
@using Services.Dto.Response
@using Services.Services.Interfaces
@inject IEventService EventService
@rendermode InteractiveServer

<PageTitle>TN Events</PageTitle>

<div class="text-center py-5 mb-4 bg-light rounded-3">
    <h1 class="display-4 fw-bold">Välkommen till TN Events</h1>
    <p class="lead text-muted">Hitta och boka event nära dig</p>
    <a href="/events" class="btn btn-primary btn-lg mt-2">Se alla event</a>
</div>

<h4 class="mb-3">Kommande event</h4>

@if (upcomingEvents == null)
{
    <p>Laddar...</p>
}
else if (!upcomingEvents.Any())
{
    <p>Inga kommande event just nu.</p>
}
else
{
    <div class="row">
        @foreach (var ev in upcomingEvents)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 @(ev.IsFull ? "border-warning" : "")">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@ev.Title</h5>
                        <p class="card-text text-muted">@ev.CategoryName</p>
                        <p class="card-text"><small>@ev.StartDate.ToString("yyyy-MM-dd HH:mm")</small></p>
                        <p class="card-text">
                            @if (ev.IsFull)
                            {
                                <span class="badge bg-warning text-dark">Fullbokat</span>
                            }
                            else
                            {
                                <span>Platser kvar: @ev.AvailableSpots / @ev.Capacity</span>
                            }
                        </p>
                        <a href="/events/@ev.Id" class="btn btn-outline-primary mt-auto">Visa</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<EventResponseDto>? upcomingEvents;

    protected override async Task OnInitializedAsync()
    {
        var allEvents = await EventService.GetAllEventsAsync();
        upcomingEvents = allEvents
            .Where(e => !e.IsCancelled && e.StartDate > DateTime.Now)
            .OrderBy(e => e.StartDate)
            .Take(3)
            .ToList();
    }
}
