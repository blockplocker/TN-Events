@page "/admin/manage-members"
@using Microsoft.AspNetCore.Authorization
@using Services.Dto.Response
@using Services.Services.Interfaces
@inject IMemberService MemberService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Hantera medlemmar</PageTitle>

<h3>Hantera medlemmar</h3>

<a href="/admin" class="btn btn-secondary mb-3">← Tillbaka till admin</a>

@if (members == null)
{
    <p>Laddar...</p>
}
else if (!members.Any())
{
    <div class="alert alert-info">Inga medlemmar registrerade.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Namn</th>
                    <th>Email</th>
                    <th>Roll</th>
                    <th>Bokningar</th>
                    <th>Hantera</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in members)
                {
                    <tr>
                        <td>@member.FirstName @member.LastName</td>
                        <td>@member.Email</td>
                        <td>
                            @if (member.IsAdmin)
                            {
                                <span class="badge bg-primary">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Användare</span>
                            }
                        </td>
                        <td>@member.BookingCount</td>
                        <td>
                            @if (!member.IsAdmin)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAdmin(member.UserId, true)">
                                    Gör admin
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleAdmin(member.UserId, false)">
                                    Ta bort admin
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<MemberDto>? members;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        members = await MemberService.GetAllMembersAsync();
    }

    private async Task ToggleAdmin(string userId, bool makeAdmin)
    {
        await MemberService.ToggleAdminAsync(userId, makeAdmin);
        await LoadMembers();
    }
}
