@page "/admin/manage-events"
@using Microsoft.AspNetCore.Authorization
@using Services.Dto.Response
@using Services.Services.Interfaces
@inject IEventService EventService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Hantera event</PageTitle>

<h3>Hantera event</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/admin" class="btn btn-secondary">← Tillbaka till admin</a>
    <a href="/admin/create-event" class="btn btn-success">+ Skapa nytt event</a>
</div>

@if (events == null)
{
    <p>Laddar...</p>
}
else if (!events.Any())
{
    <div class="alert alert-info">Inga event finns ännu.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Titel</th>
                    <th>Kategori</th>
                    <th>Datum</th>
                    <th>Bokningar</th>
                    <th>Status</th>
                    <th>Hantera</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in events)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td>@ev.CategoryName</td>
                        <td>@ev.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@ev.BookedCount / @ev.Capacity</td>
                        <td>
                            @if (ev.IsCancelled)
                            {
                                <span class="badge bg-danger">Inställt</span>
                            }
                            else if (ev.IsFull)
                            {
                                <span class="badge bg-warning text-dark">Fullbokat</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Öppet</span>
                            }
                        </td>
                        <td>
                            <a href="/admin/edit-event/@ev.Id" class="btn btn-sm btn-outline-primary me-1">Redigera</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelEvent(ev.Id)">
                                @(ev.IsCancelled ? "Återställ" : "Ställ in")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<EventResponseDto>? events;

    protected override async Task OnInitializedAsync()
    {
        events = await EventService.GetAllEventsAdminAsync();
    }

    private async Task CancelEvent(int eventId)
    {
        await EventService.ToggleCancelEventAsync(eventId);
        events = await EventService.GetAllEventsAdminAsync();
    }
}
