@page "/admin/manage-categories"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Services.Dto.Response
@using Services.Services.Interfaces
@inject ICategoryService CategoryService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Hantera kategorier</PageTitle>

<h3>Hantera kategorier</h3>

<a href="/admin" class="btn btn-secondary mb-3">← Tillbaka till admin</a>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Skapa ny kategori</h5>
                <EditForm Model="Input" OnValidSubmit="HandleCreate" FormName="create-category">
                    <DataAnnotationsValidator />
                    <div class="input-group">
                        <InputText @bind-Value="Input.Name" class="form-control" placeholder="Kategorinamn" />
                        <button type="submit" class="btn btn-primary">Lägg till</button>
                    </div>
                    <ValidationMessage For="() => Input.Name" class="text-danger" />
                </EditForm>
            </div>
        </div>
    </div>
</div>

@if (categories == null)
{
    <p>Laddar...</p>
}
else if (!categories.Any())
{
    <div class="alert alert-info">Inga kategorier finns ännu.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Namn</th>
                    <th>Hantera</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in categories)
                {
                    <tr>
                        <td>@cat.Id</td>
                        <td>@cat.Name</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(cat.Id)">
                                Ta bort
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private string? successMessage;

    [SupplyParameterFromForm]
    private CategoryInput Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        categories = await CategoryService.GetAllCategoriesAsync();
    }

    private async Task HandleCreate()
    {
        await CategoryService.CreateCategoryAsync(Input.Name);
        successMessage = $"Kategori '{Input.Name}' skapades!";
        Input = new();
        categories = await CategoryService.GetAllCategoriesAsync();
    }

    private async Task DeleteCategory(int id)
    {
        await CategoryService.DeleteCategoryAsync(id);
        categories = await CategoryService.GetAllCategoriesAsync();
    }

    private sealed class CategoryInput
    {
        [Required(ErrorMessage = "Kategorinamn krävs")]
        public string Name { get; set; } = "";
    }
}
