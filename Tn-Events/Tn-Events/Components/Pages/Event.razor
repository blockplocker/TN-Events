@page "/events"
@using Services.Dto
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Services.Dto.Response
@using Services.Services.Interfaces
@inject IEventService EventService
@inject IBookingService BookingService
@rendermode InteractiveServer

@attribute [Authorize]

<PageTitle>Event</PageTitle>

<h3>Alla event</h3>

@if (events == null)
{
    <p>Laddar...</p>
}
else if (!events.Any())
{
    <p>Inga event tillgängliga just nu.</p>
}
else
{
    <div class="row">
        @foreach (var ev in events)
        {
            <div class="col-md-4 mb-3">
                <div class="card @(ev.IsCancelled ? "border-danger opacity-75" : "")">
                    <div class="card-body">
                        <h5 class="card-title">
                            @ev.Title
                            @if (ev.IsCancelled)
                            {
                                <span class="badge bg-danger ms-2">Inställt</span>
                            }
                        </h5>
                        <p class="card-text">@ev.CategoryName</p>
                        <p class="card-text"><small>@ev.StartDate.ToString("yyyy-MM-dd HH:mm")</small></p>
                        @if (userBookings.TryGetValue(ev.Id, out var booking))
                        {
                            @if (booking.BookingStatus == BookingStatus.Confirmed)
                            {
                                <span class="badge bg-success mb-2">Bokad</span>
                            }
                            else if (booking.BookingStatus == BookingStatus.Waitinglist)
                            {
                                <span class="badge bg-warning text-dark mb-2">Köplats: @booking.WaitingNumber</span>
                            }
                        }
                        @if (!ev.IsCancelled)
                        {
                            <p class="card-text">Platser kvar: @ev.AvailableSpots / @ev.Capacity</p>
                        }
                        <a href="/events/@ev.Id" class="btn btn-primary">Visa</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private List<EventResponseDto>? events;
    private Dictionary<int, BookingResponseDto> userBookings = new();

    protected override async Task OnInitializedAsync()
    {
        events = await EventService.GetAllEventsAsync();

        var authState = await AuthenticationStateTask;
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userId))
        {
            userBookings = await BookingService.GetUserActiveBookingsByEventAsync(userId);
        }
    }
}
